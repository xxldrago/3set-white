# 3set-white — environment template (PLACEHOLDERS ONLY, never real values).
# Copy to .env.local for local dev. Real secrets live only in env / secret manager.
# NEVER commit real values — see Pitfall 7 (secret hygiene).

# Telegram bot token (production bot). Obtain via BotFather.
BOT_TOKEN=your-prod-bot-token-here
# Public Telegram bot username (without @) for the Login Widget.
# NEXT_PUBLIC_* is baked into the client bundle at BUILD time — pass via
# compose build args (BOT_PUBLIC_USERNAME in the server .env).
BOT_PUBLIC_USERNAME=threeSet_bot
# Telegram bot token (separate test bot for local dev polling). Obtain via BotFather.
BOT_TEST_TOKEN=your-test-bot-token-here
# Bot username (without @) for the bot-redirect login deep link (plan 06-06).
# SERVER-ONLY. Must match BOT_PUBLIC_USERNAME so the deep link opens the same
# bot the cabinet shows. Optional: when unset the route resolves it via getMe().
TELEGRAM_BOT_USERNAME=threeSet_bot
# Postgres connection string (local dev via Compose or Homebrew Postgres).
# PROD: the compose `web.environment` override rewrites this to point at the
# internal `db` host using DB_PASSWORD below — a value must still be present
# here to satisfy the fail-fast env schema.
DATABASE_URL=postgresql://user:password@localhost:5432/setwhite
# Postgres password for the prod `db` service (docker-compose.prod.yml reads
# ${DB_PASSWORD}). Generate: openssl rand -hex 24. Never commit the real value.
DB_PASSWORD=your-db-password-here
# Random >=256-bit secret for jose HS256 session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=your-32-byte-hex-session-secret-here
# Secret for Telegram webhook path + X-Telegram-Bot-Api-Secret-Token header check.
WEBHOOK_SECRET=your-webhook-secret-here
# ARTEMIDA Paid API V1 key (Bearer). SERVER-ONLY — never a NEXT_PUBLIC_* var.
ARTEMIDA_API_KEY=your-artemida-api-key-here
# ARTEMIDA Paid API V1 base URL (no trailing slash).
ARTEMIDA_BASE_URL=https://artemida.cc/v1
# Platega.io merchant credentials. SERVER-ONLY — test pair in .env.local, live
# pair on the server. Never a NEXT_PUBLIC_* var.
PLATEGA_MERCHANT_ID=your-merchant-id-here
PLATEGA_SECRET=your-platega-secret-here
# Platega.io base URL (no trailing slash; test host differs from live).
PLATEGA_BASE_URL=https://app.platega.io
# Public origin used for Platega return/failed URLs and the webhook host
# (OPS-01). Prod: https://my.3set.online. Local dev: http://localhost:3000.
APP_BASE_URL=https://my.3set.online
# Bot runtime mode: polling (local dev, test token) or webhook (prod, HTTPS).
# Prod sets BOT_MODE=webhook; local dev uses polling.
BOT_MODE=polling
# Local upload volume for ticket attachments (D-53). SERVER-ONLY — never a
# NEXT_PUBLIC_* var. Mirrors the compose mount at /data/uploads.
UPLOAD_DIR=/data/uploads
# Comma-separated Telegram ids allowed to reply/close tickets (D-51).
# Leave empty for no admins. Placeholder only — never commit real ids.
# ADMIN_TELEGRAM_IDS=123456789,987654321
# Shared secret for the optional manual reconcile trigger (POST /api/cron/reconcile).
# Unset closes the route (503); the instrumentation worker is the primary path.
# CRON_SECRET=your-cron-secret-here
# White Label subscription host (D-72/D-74). The provider returns sub-links on
# this host; the code verifies/falls back and never constructs the host.
WHITELABEL_HOST=sub.my.3set.online
# ARTEMIDA low-balance alert threshold in RUB (D-70). Integer >= 0.
ARTEMIDA_LOW_BALANCE_RUB=500
